---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const pillars = data.architecturePillars ?? [];
const scenarios = data.scenarios ?? [];
const metrics = data.metrics ?? [];
---

<section aria-labelledby="mederi-title" class="card-mederi gradient-border rounded-3xl p-8 md:p-10 animate-fade-in-up delay-200">
  <!-- Top meta row -->
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex flex-wrap items-center gap-2.5">
      <!-- Award badge -->
      {data.award && (
        <span class="badge-award">
          <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          {data.awardShort ?? data.award}
        </span>
      )}
      <!-- Status badge -->
      {data.badge && (
        <span class="badge-status clear">
          <span class="pulse-dot h-1.5 w-1.5 rounded-full bg-emerald-400 inline-block"></span>
          {data.badge}
        </span>
      )}
      <!-- PoC badge -->
      <span class="mono text-xs text-zinc-500 border border-zinc-800/60 rounded-full px-2.5 py-1">
        PoC · 2025
      </span>
    </div>

    <!-- Action buttons -->
    <div class="flex flex-wrap items-center gap-2">
      <a href={`/projects/${project.slug}`} class="btn-primary text-xs py-2 px-3.5 no-underline">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
        Architecture Deep Dive
      </a>
      {data.githubUrl && (
        <a href={data.githubUrl} target="_blank" rel="noreferrer noopener" class="btn-ghost text-xs py-2 px-3.5 no-underline">
          <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.35.73-4.06-1.62-4.06-1.62a3.2 3.2 0 0 0-1.35-1.78c-1.11-.76.08-.74.08-.74a2.52 2.52 0 0 1 1.84 1.24 2.56 2.56 0 0 0 3.5 1 2.56 2.56 0 0 1 .76-1.61c-2.68-.31-5.49-1.34-5.49-5.97a4.67 4.67 0 0 1 1.24-3.24 4.35 4.35 0 0 1 .12-3.2s1.01-.32 3.3 1.23a11.38 11.38 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23a4.35 4.35 0 0 1 .12 3.2 4.66 4.66 0 0 1 1.24 3.24c0 4.64-2.82 5.65-5.51 5.96a2.87 2.87 0 0 1 .82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 .5Z"/>
          </svg>
          GitHub
        </a>
      )}
    </div>
  </div>

  <!-- Title block -->
  <div class="mt-6">
    <h2 id="mederi-title" class="text-3xl font-semibold tracking-tight text-white md:text-4xl">
      {data.title}
    </h2>
    <p class="mt-2 text-lg font-medium tracking-tight" style="color: #6ee7b7;">
      {data.subtitle}
    </p>
    <p class="mt-4 max-w-2xl leading-relaxed text-zinc-400">
      {data.description}
    </p>
  </div>

  <!-- Metrics strip -->
  {metrics.length > 0 && (
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {metrics.map((m) => (
        <div class="pillar-card rounded-xl px-4 py-3 text-center">
          <p class="mono text-xl font-bold text-white">{m.value}</p>
          <p class="mt-0.5 text-xs text-zinc-500">{m.label}</p>
        </div>
      ))}
    </div>
  )}

  <!-- Architecture pillars -->
  {pillars.length > 0 && (
    <div class="mt-8">
      <p class="section-label mb-4">Architecture Pillars</p>
      <div class="grid gap-4 md:grid-cols-3">
        {pillars.map((pillar) => (
          <div class="pillar-card rounded-2xl p-5">
            <span class="text-2xl" aria-hidden="true">{pillar.icon}</span>
            <h3 class="mt-3 text-sm font-semibold tracking-tight text-white leading-snug">
              {pillar.title}
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-zinc-400">
              {pillar.description}
            </p>
            {pillar.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {pillar.tags.map((tag) => (
                  <span class="tag tag-emerald text-[10px] px-2 py-0.5">{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Clinical scenarios -->
  {scenarios.length > 0 && (
    <div class="mt-8">
      <p class="section-label mb-4">Live Demo Scenarios</p>
      <div class="space-y-2.5">
        {scenarios.map((scenario, i) => (
          <div class="flex items-start gap-3 rounded-xl border border-zinc-800/60 bg-zinc-950/50 p-4">
            <span class={`badge-status ${scenario.outcome} mt-0.5 shrink-0`}>
              {scenario.outcome === 'clear' ? '✓ Clear' : scenario.outcome === 'alert' ? '⚠ Alert' : '✕ Critical'}
            </span>
            <div class="min-w-0">
              <p class="mono text-xs font-medium text-zinc-200">
                Scenario {i + 1} — {scenario.title}
              </p>
              <p class="mt-1 text-xs leading-relaxed text-zinc-500">{scenario.summary}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Tech tag cloud -->
  {data.tags.length > 0 && (
    <div class="mt-8 flex flex-wrap gap-2">
      {data.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</section>
