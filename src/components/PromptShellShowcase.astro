---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const pillars = data.architecturePillars ?? [];
const metrics = data.metrics ?? [];
---

<section aria-labelledby="promptshell-title" class="card-promptshell gradient-border-purple rounded-3xl p-7 md:p-8">
  <!-- Top meta row -->
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex flex-wrap items-center gap-2">
      <!-- Active badge -->
      {data.badge && (
        <span class="badge-status-purple">
          <span class="pulse-dot h-1.5 w-1.5 rounded-full bg-violet-400 inline-block"></span>
          {data.badge}
        </span>
      )}
      <span class="mono text-xs text-zinc-500 border border-zinc-800/60 rounded-full px-2.5 py-1">
        {data.period} · .NET 9 · Avalonia
      </span>
    </div>

    <!-- Action buttons -->
    <div class="flex flex-wrap items-center gap-2">
      <a href={`/projects/${project.slug}`} class="btn-ghost-purple no-underline text-xs py-2 px-3.5">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
        Deep Dive
      </a>
      {data.githubUrl && (
        <a href={data.githubUrl} target="_blank" rel="noreferrer noopener" class="btn-ghost no-underline text-xs py-2 px-3.5">
          <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.35.73-4.06-1.62-4.06-1.62a3.2 3.2 0 0 0-1.35-1.78c-1.11-.76.08-.74.08-.74a2.52 2.52 0 0 1 1.84 1.24 2.56 2.56 0 0 0 3.5 1 2.56 2.56 0 0 1 .76-1.61c-2.68-.31-5.49-1.34-5.49-5.97a4.67 4.67 0 0 1 1.24-3.24 4.35 4.35 0 0 1 .12-3.2s1.01-.32 3.3 1.23a11.38 11.38 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23a4.35 4.35 0 0 1 .12 3.2 4.66 4.66 0 0 1 1.24 3.24c0 4.64-2.82 5.65-5.51 5.96a2.87 2.87 0 0 1 .82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 .5Z"/>
          </svg>
          GitHub
        </a>
      )}
    </div>
  </div>

  <!-- Title block -->
  <div class="mt-5">
    <h2 id="promptshell-title" class="text-2xl font-semibold tracking-tight text-white md:text-3xl">
      {data.title}
    </h2>
    <p class="mt-1.5 text-base font-medium tracking-tight" style="color: #c4b5fd;">
      {data.subtitle}
    </p>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-400">
      {data.description}
    </p>
  </div>

  <!-- Metrics strip -->
  {metrics.length > 0 && (
    <div class="mt-6 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
      {metrics.map((m) => (
        <div class="pillar-card rounded-xl px-3 py-2.5 text-center">
          <p class="mono text-lg font-bold text-white">{m.value}</p>
          <p class="mt-0.5 text-xs text-zinc-500">{m.label}</p>
        </div>
      ))}
    </div>
  )}

  <!-- Architecture pillars (compact 3-col) -->
  {pillars.length > 0 && (
    <div class="mt-6">
      <p class="section-label mb-3">Architecture Pillars</p>
      <div class="grid gap-3 md:grid-cols-3">
        {pillars.map((pillar) => (
          <div class="pillar-card rounded-xl p-4">
            <span class="text-xl" aria-hidden="true">{pillar.icon}</span>
            <h3 class="mt-2.5 text-xs font-semibold tracking-tight text-white leading-snug">
              {pillar.title}
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-zinc-500 line-clamp-3">
              {pillar.description}
            </p>
            {pillar.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1">
                {pillar.tags.slice(0, 3).map((tag) => (
                  <span class="tag tag-purple text-[10px] px-2 py-0.5">{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Tech tags -->
  {data.tags.length > 0 && (
    <div class="mt-5 flex flex-wrap gap-2">
      {data.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</section>

<style>
  .card-promptshell {
    position: relative;
    border: 1px solid rgb(139 92 246 / 0.20);
    background: rgb(15 15 18 / 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: border-color 250ms ease, box-shadow 250ms ease;
    overflow: hidden;
  }

  .card-promptshell::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 50% at 50% -10%, rgb(139 92 246 / 0.06), transparent 60%);
    pointer-events: none;
  }

  .card-promptshell:hover {
    border-color: rgb(139 92 246 / 0.35);
    box-shadow: 0 0 40px -10px rgb(139 92 246 / 0.15);
  }

  .badge-status-purple {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 9999px;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    border: 1px solid rgb(139 92 246 / 0.30);
    background: rgb(139 92 246 / 0.07);
    color: #c4b5fd;
  }

  .btn-ghost-purple {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid rgb(139 92 246 / 0.25);
    color: #c4b5fd;
    transition: border-color 180ms ease, color 180ms ease, transform 120ms ease;
  }

  .btn-ghost-purple:hover {
    border-color: rgb(139 92 246 / 0.50);
    color: #ddd6fe;
    transform: translateY(-1px);
  }

  .tag-purple {
    border-color: rgb(139 92 246 / 0.30);
    background: rgb(139 92 246 / 0.06);
    color: #c4b5fd;
  }

  .gradient-border-purple::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgb(139 92 246 / 0.35), transparent 60%, rgb(59 130 246 / 0.15));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
</style>
