---

<ul class="flex flex-wrap gap-3" aria-label="Social links">
  {
    profiles.map((profile) => (
      <li>
        <a
          href={profile.url}
          class="inline-flex items-center gap-2 rounded-md border border-neutral-800 bg-neutral-900/70 px-3 py-2 text-sm text-neutral-200 no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-teal-300/60 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-300/70"
          rel="noreferrer"
          target="_blank"
        >
          <svg aria-hidden="true" class="h-4 w-4" fill="currentColor" viewBox={icons[profile.icon]?.viewBox ?? '0 0 24 24'}>
            <path d={icons[profile.icon]?.path ?? icons.link.path} />
          </svg>
          <span>{profile.name}</span>
        </a>
      </li>
    ))
  }
</ul>
