---
import type { SocialProfile } from '../types/profile';

interface Props {
  profiles: SocialProfile[];
}

const { profiles } = Astro.props;

const icons: Record<SocialProfile['icon'], string> = {
  github: 'GH',
  linkedin: 'IN',
  instagram: 'IG',
  scholar: 'GS',
  orcid: 'OR',
  x: 'X',
  email: '@',
  link: '↗',
};
---

<ul class="flex flex-wrap gap-2" aria-label="Social links">
  {
    profiles.map((profile) => (
      <li>
        <a
          href={profile.url}
          class="inline-flex items-center gap-2 border border-neutral-200 px-2 py-1 font-mono text-xs no-underline hover:border-neutral-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500 dark:border-neutral-800 dark:hover:border-neutral-600"
          rel="noreferrer"
          target="_blank"
        >
          <span aria-hidden="true">{icons[profile.icon] ?? '↗'}</span>
          <span>{profile.name}</span>
        </a>
      </li>
    ))
  }
</ul>
