---
import type { SocialProfile } from '../types/profile';

interface Props {
  profiles: SocialProfile[];
}

const { profiles } = Astro.props;

const icons: Record<SocialProfile['icon'], { viewBox: string; path: string }> = {
  github: {
    viewBox: '0 0 24 24',
    path: 'M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.35.73-4.06-1.62-4.06-1.62a3.2 3.2 0 0 0-1.35-1.78c-1.11-.76.08-.74.08-.74a2.52 2.52 0 0 1 1.84 1.24 2.56 2.56 0 0 0 3.5 1 2.56 2.56 0 0 1 .76-1.61c-2.68-.31-5.49-1.34-5.49-5.97a4.67 4.67 0 0 1 1.24-3.24 4.35 4.35 0 0 1 .12-3.2s1.01-.32 3.3 1.23a11.38 11.38 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23a4.35 4.35 0 0 1 .12 3.2 4.66 4.66 0 0 1 1.24 3.24c0 4.64-2.82 5.65-5.51 5.96a2.87 2.87 0 0 1 .82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 .5Z',
  },
  linkedin: {
    viewBox: '0 0 24 24',
    path: 'M4.98 3.5C3.34 3.5 2 4.84 2 6.48c0 1.63 1.34 2.97 2.98 2.97 1.64 0 2.98-1.34 2.98-2.97A2.99 2.99 0 0 0 4.98 3.5ZM2.4 21.5h5.17V9.7H2.4v11.8ZM10.75 9.7v11.8h5.17v-6.59c0-1.74.33-3.42 2.48-3.42 2.12 0 2.15 1.98 2.15 3.53v6.48H24v-7.48c0-3.67-.79-6.49-5.08-6.49-2.06 0-3.43 1.13-3.99 2.2h-.06V9.7h-4.12Z',
  },
  instagram: {
    viewBox: '0 0 24 24',
    path: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5Zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5ZM17.75 6a1.25 1.25 0 1 1-1.25 1.25A1.25 1.25 0 0 1 17.75 6Z',
  },
  cv: {
    viewBox: '0 0 24 24',
    path: 'M6 2h9l5 5v15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm8 1.5V8h4.5L14 3.5ZM8 12h8v1.5H8V12Zm0 3h8v1.5H8V15Zm0 3h5v1.5H8V18Z',
  },
  email: {
    viewBox: '0 0 24 24',
    path: 'M3 5h18a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm0 2v.01L12 13l9-5.99V7H3Zm18 10V9.24l-8.45 5.62a1 1 0 0 1-1.1 0L3 9.24V17h18Z',
  },
  link: {
    viewBox: '0 0 24 24',
    path: 'M10.59 13.41a1 1 0 0 0 1.41 1.41l4-4A3 3 0 0 0 11.76 6.6l-1.17 1.17a1 1 0 1 0 1.41 1.41l1.17-1.17a1 1 0 1 1 1.42 1.41l-4 4ZM13.41 10.59a1 1 0 0 0-1.41-1.41l-4 4a3 3 0 1 0 4.24 4.24l1.17-1.17a1 1 0 0 0-1.41-1.41l-1.17 1.17a1 1 0 1 1-1.42-1.41l4-4Z',
  },
};
---

<ul class="flex flex-wrap gap-2" aria-label="Social links">
  {
    profiles.map((profile) => (
      <li>
        <a
          href={profile.url}
          class="group inline-flex items-center gap-2 rounded-full border border-neutral-800/70 bg-neutral-900/35 px-3 py-2 font-mono text-xs tracking-tight text-neutral-300 no-underline backdrop-blur-sm transition-all duration-200 hover:border-neutral-700 hover:bg-neutral-900/60 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400/60"
          rel="noreferrer"
          target={profile.url.startsWith('mailto:') || profile.url.startsWith('/') ? undefined : '_blank'}
        >
          <svg aria-hidden="true" class="h-4 w-4 text-neutral-400 transition-colors duration-200 group-hover:text-neutral-100" fill="currentColor" viewBox={icons[profile.icon]?.viewBox ?? '0 0 24 24'}>
            <path d={icons[profile.icon]?.path ?? icons.link.path} />
          </svg>
          <span class="transition-transform duration-200 group-hover:translate-x-0.5">{profile.name}</span>
        </a>
      </li>
    ))
  }
</ul>
