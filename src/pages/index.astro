---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import profileData from '../data/profile.json';
import type { Profile } from '../types/profile';

const profile = profileData as Profile;
---

<BaseLayout title={profile.name} description={profile.shortBio}>
  <header class="sticky top-4 z-50 mb-12 pt-4">
    <nav class="mx-auto flex w-full max-w-2xl items-center justify-between rounded-full border border-neutral-800/60 bg-neutral-950/80 px-5 py-2.5 backdrop-blur-md">
      <p class="mono text-xs tracking-tight text-neutral-400">csabisoos://portfolio</p>
      <div class="flex items-center gap-4">
        <a class="mono text-xs tracking-tight text-neutral-300 hover:text-white" href="#focus">Focus</a>
        <a class="mono text-xs tracking-tight text-neutral-300 hover:text-white" href="#track">Track</a>
        <a class="mono text-xs tracking-tight text-neutral-300 hover:text-white" href={profile.contact.email}>Contact</a>
      </div>
    </nav>
  </header>

  <section class="rounded-3xl border border-neutral-800/70 bg-neutral-900/30 p-8 backdrop-blur-sm transition-all duration-200 hover:border-neutral-700 hover:bg-neutral-900/60 md:p-10">
    <span class="mono inline-flex rounded-full border border-neutral-800/80 bg-neutral-950/80 px-3 py-1 text-xs text-neutral-300">
      {profile.location}
    </span>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-white sm:text-5xl">{profile.name}</h1>
    <p class="mt-3 text-xl tracking-tight text-neutral-200">{profile.title}</p>
    <p class="mt-4 max-w-3xl text-neutral-400">{profile.shortBio}</p>

    <div class="mt-8">
      <SocialLinks profiles={profile.socialProfiles} />
    </div>
  </section>

  <section id="focus" class="mt-10 rounded-3xl border border-neutral-800/70 bg-neutral-900/30 p-8 backdrop-blur-sm transition-all duration-200 hover:border-neutral-700 hover:bg-neutral-900/60 md:p-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="text-2xl font-semibold tracking-tight text-white">Expertise & Focus Areas</h2>
      <p class="mono text-xs text-neutral-500">Academic track: UPV/EHU</p>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        profile.focusAreas.map((area) => (
          <span class="mono inline-flex rounded-full border border-neutral-800/70 bg-neutral-950/70 px-3 py-1.5 text-xs text-neutral-300 transition-all duration-200 hover:border-neutral-700 hover:text-white">
            {area}
          </span>
        ))
      }
    </div>
  </section>

  <section id="track" class="mt-10 rounded-3xl border border-neutral-800/70 bg-neutral-900/30 p-8 backdrop-blur-sm transition-all duration-200 hover:border-neutral-700 hover:bg-neutral-900/60 md:p-10">
    <h2 class="text-2xl font-semibold tracking-tight text-white">Career & Academic Track</h2>
    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <div>
        <p class="mono text-xs uppercase tracking-[0.2em] text-neutral-500">Experience</p>
        <div class="mt-4 space-y-4">
          {
            profile.experience.map((entry) => (
              <article class="rounded-2xl border border-neutral-800/70 bg-neutral-900/30 p-5 transition-all duration-200 hover:border-neutral-700 hover:bg-neutral-900/60">
                <p class="mono text-xs text-neutral-500">{entry.period}</p>
                <h3 class="mt-2 text-lg font-semibold tracking-tight text-white">{entry.role}</h3>
                <p class="mono mt-1 text-sm text-neutral-300">{entry.organization}</p>
                <p class="mt-3 text-sm text-neutral-400">{entry.focus}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <p class="mono text-xs uppercase tracking-[0.2em] text-neutral-500">Education</p>
        <div class="mt-4 space-y-4">
          {
            profile.education.map((entry) => (
              <article class="rounded-2xl border border-neutral-800/70 bg-neutral-900/30 p-5 transition-all duration-200 hover:border-neutral-700 hover:bg-neutral-900/60">
                <p class="mono text-xs text-neutral-500">{entry.period}</p>
                <h3 class="mt-2 text-lg font-semibold tracking-tight text-white">{entry.degree}</h3>
                <p class="mono mt-1 text-sm text-neutral-300">{entry.institution}</p>
                <p class="mt-3 text-sm text-neutral-400">{entry.focus}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <footer class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-800/70 pt-8">
    <p class="mono text-xs text-neutral-500">{new Date().toISOString()}</p>
    <p class="text-xs text-neutral-500">© {new Date().getFullYear()} {profile.name}</p>
    <a class="mono text-xs text-neutral-400 hover:text-white" href={profile.contact.email}>
      {profile.contact.email.replace('mailto:', '')}
    </a>
  </footer>
</BaseLayout>
