---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import profileData from '../data/profile.json';
import type { Profile } from '../types/profile';

const profile = profileData as Profile;
---

<BaseLayout title={`${profile.name} — Portfolio`} description={profile.shortBio}>
  <header class="sticky top-0 z-30 -mx-6 mb-10 border-b border-neutral-800/60 bg-neutral-950/70 px-6 py-4 backdrop-blur-md md:-mx-12 md:px-12">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
      <p class="font-mono text-sm text-neutral-300">csabisoos://portfolio</p>
      <div class="flex items-center gap-3">
        <a class="text-sm text-neutral-300 hover:text-white" href={profile.contact.email}>Email</a>
        <span class="rounded-full border border-neutral-700 bg-neutral-900/80 px-3 py-1 text-xs text-neutral-200">
          {profile.statusBadge}
        </span>
      </div>
    </div>
  </header>

  <section class="rounded-2xl border border-neutral-800/70 bg-neutral-900/50 p-8 shadow-[0_0_0_1px_rgba(38,38,38,0.3)]">
    <p class="mb-3 inline-flex rounded-full border border-teal-300/40 bg-teal-400/10 px-3 py-1 font-mono text-xs text-teal-200">
      {profile.location}
    </p>
    <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">{profile.name}</h1>
    <p class="mt-3 text-lg text-neutral-200">{profile.title}</p>
    <p class="mt-4 max-w-3xl text-neutral-400">{profile.shortBio}</p>

    <div class="mt-6 flex flex-wrap gap-2">
      {
        profile.roles.map((role) => (
          <span class="rounded-md border border-neutral-700/70 bg-neutral-950/60 px-3 py-1 font-mono text-xs text-neutral-300">
            {role}
          </span>
        ))
      }
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      {
        profile.focusAreas.map((area) => (
          <span class="rounded-md border border-neutral-800/70 px-3 py-1 text-xs text-neutral-400">{area}</span>
        ))
      }
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href={profile.contact.email}
        class="inline-flex items-center rounded-md border border-neutral-700 bg-neutral-900/80 px-4 py-2 text-sm text-neutral-100 no-underline hover:border-teal-300/50 hover:text-white"
      >
        {profile.contact.email.replace('mailto:', '')}
      </a>
      <SocialLinks profiles={profile.socialProfiles} />
    </div>
  </section>

  <section class="mt-10 grid gap-6 md:grid-cols-3">
    <article class="rounded-xl border border-neutral-800/70 bg-neutral-900/40 p-5">
      <h2 class="text-base font-semibold text-white">Selected Projects</h2>
      <p class="mt-4 text-sm text-neutral-500">No verified entries yet.</p>
    </article>

    <article class="rounded-xl border border-neutral-800/70 bg-neutral-900/40 p-5">
      <h2 class="text-base font-semibold text-white">Academic Work</h2>
      <p class="mt-4 text-sm text-neutral-500">No verified entries yet.</p>
    </article>

    <article class="rounded-xl border border-neutral-800/70 bg-neutral-900/40 p-5">
      <h2 class="text-base font-semibold text-white">Writing</h2>
      <p class="mt-4 text-sm text-neutral-500">No verified entries yet.</p>
    </article>
  </section>
</BaseLayout>
