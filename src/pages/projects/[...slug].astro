---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props:  { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await project.render();

const pillars     = data.architecturePillars ?? [];
const scenarios   = data.scenarios ?? [];
const metrics     = data.metrics ?? [];
const screenshots = data.screenshots ?? [];
const isPurple    = project.slug === 'promptshell';
const accentColor = isPurple ? '#c4b5fd' : '#6ee7b7';
---

<BaseLayout
  title={data.title}
  description={data.description}
>
  <!-- Back navigation -->
  <header class="sticky top-4 z-50 mb-12 pt-4">
    <nav class="mx-auto flex w-full max-w-5xl items-center justify-between rounded-full border border-zinc-800/60 bg-zinc-950/80 px-5 py-2.5 backdrop-blur-md">
      <a href="/" class="nav-pill no-underline" aria-label="Back to portfolio">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        csabisoos.github.io
      </a>
      <div class="flex items-center gap-3">
        {data.githubUrl && (
          <a href={data.githubUrl} target="_blank" rel="noreferrer noopener" class="nav-pill no-underline">
            GitHub
          </a>
        )}
        {data.award && (
          <span class="hidden sm:flex badge-award text-[10px] px-2 py-0.5">
            🏆 {data.awardShort}
          </span>
        )}
      </div>
    </nav>
  </header>

  <!-- Hero -->
  <section class="animate-fade-in-up">
    <div class="flex flex-wrap items-center gap-2.5">
      {data.award && (
        <span class="badge-award">
          <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          {data.awardShort ?? data.award}
        </span>
      )}
      {data.badge && (
        <span class="badge-status clear">
          <span class="pulse-dot h-1.5 w-1.5 rounded-full bg-emerald-400 inline-block"></span>
          {data.badge}
        </span>
      )}
      {data.role && (
        <span class="mono text-xs text-zinc-500">{data.role}</span>
      )}
    </div>

    <h1 class="mt-5 text-4xl font-bold tracking-tight text-white md:text-5xl">{data.title}</h1>
    <p class="mt-2 text-xl font-medium tracking-tight" style={`color: ${accentColor};`}>{data.subtitle}</p>
    <p class="mt-4 max-w-2xl text-zinc-400 leading-relaxed">{data.description}</p>

    <!-- Action buttons -->
    <div class="mt-6 flex flex-wrap gap-3">
      {data.githubUrl && (
        <a href={data.githubUrl} target="_blank" rel="noreferrer noopener" class="btn-ghost no-underline">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.35.73-4.06-1.62-4.06-1.62a3.2 3.2 0 0 0-1.35-1.78c-1.11-.76.08-.74.08-.74a2.52 2.52 0 0 1 1.84 1.24 2.56 2.56 0 0 0 3.5 1 2.56 2.56 0 0 1 .76-1.61c-2.68-.31-5.49-1.34-5.49-5.97a4.67 4.67 0 0 1 1.24-3.24 4.35 4.35 0 0 1 .12-3.2s1.01-.32 3.3 1.23a11.38 11.38 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23a4.35 4.35 0 0 1 .12 3.2 4.66 4.66 0 0 1 1.24 3.24c0 4.64-2.82 5.65-5.51 5.96a2.87 2.87 0 0 1 .82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 .5Z"/>
          </svg>
          View Repository
        </a>
      )}
    </div>
  </section>

  <!-- Metrics -->
  {metrics.length > 0 && (
    <section class="mt-10 animate-fade-in-up delay-100">
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {metrics.map((m) => (
          <div class="card-glass rounded-2xl px-4 py-5 text-center">
            <p class="mono text-2xl font-bold text-white">{m.value}</p>
            <p class="mt-1 text-xs text-zinc-500">{m.label}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Architecture pillars -->
  {pillars.length > 0 && (
    <section class="mt-10 animate-fade-in-up delay-200">
      <p class="section-label mb-5">Core Architecture — Three Pillars</p>
      <div class="grid gap-4 md:grid-cols-3">
        {pillars.map((pillar) => (
          <div class="pillar-card rounded-2xl p-6">
            <span class="text-3xl" aria-hidden="true">{pillar.icon}</span>
            <h3 class="mt-4 text-base font-semibold tracking-tight text-white">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{pillar.description}</p>
            {pillar.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {pillar.tags.map((tag) => (
                  <span class="tag tag-emerald text-[10px] px-2 py-0.5">{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Demo scenarios -->
  {scenarios.length > 0 && (
    <section class="mt-10 animate-fade-in-up delay-300">
      <p class="section-label mb-5">{isPurple ? "Execution & Safety Scenarios" : "Clinical Demo Scenarios"}</p>
      <div class="space-y-3">
        {scenarios.map((scenario, i) => (
          <div class="card-glass rounded-2xl p-5">
            <div class="flex items-start gap-4">
              <span class={`badge-status ${scenario.outcome} shrink-0 mt-0.5`}>
                {scenario.outcome === 'clear' ? '✓ Clear' : scenario.outcome === 'alert' ? '⚠ Alert' : '✕ Critical'}
              </span>
              <div>
                <p class="mono text-sm font-medium text-zinc-200">Scenario {i + 1} — {scenario.title}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">{scenario.summary}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Application Interface Screenshots -->
  {screenshots.length > 0 && (
    <section class="mt-14 animate-fade-in-up delay-350">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <div>
          <p class="section-label mb-1">Application Interface</p>
          <h2 class="text-2xl font-bold tracking-tight text-white">Visual Walkthrough & Live Runtime</h2>
        </div>
        <span class="mono text-xs text-zinc-400 border border-zinc-800/80 rounded-full px-3 py-1 bg-zinc-900/50">
          {screenshots.length} App Screenshots
        </span>
      </div>

      <div class="space-y-8">
        {screenshots.map((s, index) => (
          <figure class="card-glass rounded-3xl overflow-hidden border border-zinc-800/80 shadow-2xl bg-zinc-950/80 group">
            <!-- macOS Window Header Bar -->
            <div class="flex items-center justify-between px-5 py-3.5 border-b border-zinc-800/80 bg-zinc-900/70 backdrop-blur-md">
              <div class="flex items-center gap-2">
                <span class="h-3 w-3 rounded-full bg-[#ff5f56] border border-[#e0443e]/40 shadow-sm"></span>
                <span class="h-3 w-3 rounded-full bg-[#ffbd2e] border border-[#dea123]/40 shadow-sm"></span>
                <span class="h-3 w-3 rounded-full bg-[#27c93f] border border-[#1aab29]/40 shadow-sm"></span>
              </div>
              <p class="mono text-xs text-zinc-300 font-medium">PromptShell Autobot — {s.caption}</p>
              <span class="mono text-[11px] text-zinc-500 uppercase tracking-widest">FIG. {index + 1}</span>
            </div>

            <!-- Screenshot Image Container -->
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="block relative overflow-hidden bg-black/50">
              <img
                src={s.url}
                alt={s.caption}
                class="w-full h-auto object-contain transition-transform duration-500 ease-out group-hover:scale-[1.01]"
                loading={index === 0 ? "eager" : "lazy"}
              />
              <div class="absolute inset-0 bg-violet-500/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none flex items-center justify-center">
                <span class="mono text-xs text-white bg-zinc-950/80 border border-violet-500/40 px-3.5 py-1.5 rounded-full shadow-lg backdrop-blur-sm">
                  🔍 Click to view full resolution
                </span>
              </div>
            </a>

            <!-- Caption / Tech Notes -->
            <figcaption class="p-5 md:p-6 border-t border-zinc-800/80 bg-zinc-900/40">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                <div class="max-w-2xl">
                  <h3 class="text-base font-semibold text-white tracking-tight">{s.caption}</h3>
                  {s.description && (
                    <p class="mt-1.5 text-xs text-zinc-400 leading-relaxed">{s.description}</p>
                  )}
                </div>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="mono text-xs text-violet-400 hover:text-violet-300 transition-colors inline-flex items-center gap-1 shrink-0">
                  Open image
                  <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- Prose content -->
  <section class="mt-12 animate-fade-in-up delay-400">
    <div class="card-glass rounded-3xl p-8 md:p-10 prose-dark prose prose-invert max-w-none
      [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-white [&_h2]:mt-10 [&_h2]:mb-4
      [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-zinc-200 [&_h3]:mt-6 [&_h3]:mb-3
      [&_p]:text-zinc-400 [&_p]:leading-relaxed
      [&_ul]:text-zinc-400 [&_li]:my-1
      [&_strong]:text-zinc-200 [&_strong]:font-medium
      [&_a]:text-emerald-400 [&_a]:no-underline [&_a:hover]:text-emerald-300
      [&_code]:rounded [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-emerald-300 [&_code]:bg-emerald-950/40 [&_code]:text-xs
      [&_pre]:rounded-xl [&_pre]:bg-zinc-950/80 [&_pre]:border [&_pre]:border-zinc-800/60 [&_pre]:p-5 [&_pre]:overflow-x-auto
      [&_blockquote]:border-l-2 [&_blockquote]:border-emerald-500/40 [&_blockquote]:pl-4 [&_blockquote]:text-zinc-400 [&_blockquote]:italic
      [&_table]:w-full [&_table]:text-sm [&_table]:border-collapse
      [&_th]:text-left [&_th]:py-2.5 [&_th]:px-3 [&_th]:text-xs [&_th]:uppercase [&_th]:tracking-wider [&_th]:text-zinc-500 [&_th]:border-b [&_th]:border-zinc-800/60
      [&_td]:py-2.5 [&_td]:px-3 [&_td]:text-zinc-400 [&_td]:border-b [&_td]:border-zinc-900/60
      [&_hr]:border-zinc-800/60 [&_hr]:my-8
    ">
      <Content />
    </div>
  </section>

  <!-- Tags -->
  {data.tags.length > 0 && (
    <section class="mt-8 animate-fade-in-up delay-500">
      <div class="flex flex-wrap gap-2">
        {data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </section>
  )}

  <!-- Footer -->
  <footer class="mt-16 flex flex-wrap items-center justify-between gap-3 border-t border-zinc-800/60 pt-8">
    <a href="/" class="mono text-xs text-zinc-500 hover:text-zinc-300 no-underline transition-colors">← Back to portfolio</a>
    <p class="mono text-xs text-zinc-600">{new Date().toISOString()}</p>
  </footer>
</BaseLayout>
